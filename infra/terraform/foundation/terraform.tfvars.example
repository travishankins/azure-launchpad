# Copy to terraform.tfvars (gitignored) or pass via -var-file.

subscription_id = "00000000-0000-0000-0000-000000000000"
scenario        = "baseline"

# Optional overrides
# location                  = "westcentralus"
# name_prefix               = "contoso"
# region_short              = "wcus"
# address_space_hub         = "10.0.0.0/23"
# address_space_spoke       = "10.0.2.0/23"
# log_retention_days        = 30
# on_premises_address_space = ["192.168.0.0/16"]  # required for vpn|full
# tags = {
#   workload    = "azure-launchpad"
#   iac         = "terraform"
#   cost_center = "platform"
# }

# Optional: monthly budget + email alerts (free)
# budget_enabled               = true
# budget_amount                = 200
# budget_alert_emails          = ["platform@example.com", "finance@example.com"]
# budget_thresholds            = [50, 80, 100]
# budget_resource_group_names  = []  # default: whole subscription

# ----------------------------------------------------------------------------
# Azure Monitor Workbook (opt-in) — see governance/workbook docs.
# ----------------------------------------------------------------------------
# workbook_enabled = true
