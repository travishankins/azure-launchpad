# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local deployment plans and generated backend configuration
.launchpad/

# Keep lock file (committed for reproducibility)
!.terraform.lock.hcl

# Local secrets / env
*.tfvars.local
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Bicep build artifacts (generated by `az bicep build`)
infra/bicep/**/*.json
!infra/bicep/**/*.bicepparam
# Wizard-generated parameter files (contain subscription/tenant IDs)
infra/bicep/**/wizard*.bicepparam
infra/terraform/**/wizard*.auto.tfvars
# ...except hand-authored content loaded by Bicep modules:
!infra/bicep/**/workbooks/*.json
